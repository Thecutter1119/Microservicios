# ============================================================
# ms-reportes [REP] — Variables de entorno
# Módulo 6 — Transversales
# ============================================================

# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:maicol@localhost:5432/db_reportes
DATABASE_URL_SYNC=postgresql://postgres:maicol@localhost:5432/db_reportes

# ── Modo desarrollo ───────────────────────────────────────────
# true  → saltea ms-autenticacion y ms-roles completamente
# false → llama a los microservicios reales (producción)
DEV_SKIP_AUTH=true

# true  → devuelve datos simulados en lugar de llamar CAL/INV/PRE
# false → llama a los microservicios fuente reales
DEV_SKIP_SOURCES=true

# Usuario y rol que se inyectan cuando DEV_SKIP_AUTH=true
# 1=admin  2=rector  3=dir.academico  4=tesoreria
DEV_USER_ID=1
DEV_ROL_ID=1

# ── Token de aplicación ───────────────────────────────────────
APP_TOKEN_REP=REP-APP-TOKEN-SECRET-2026

# ── URLs microservicios (solo aplican cuando DEV_SKIP_*=false) ─
MS_AUTENTICACION_URL=http://localhost:8010
MS_ROLES_URL=http://localhost:8011
MS_CALIFICACIONES_URL=http://localhost:8001
MS_INVENTARIO_URL=http://localhost:8002
MS_PRESUPUESTO_URL=http://localhost:8003
MS_AUDITORIA_URL=http://localhost:8004

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULER_INTERVAL_MINUTES=1
